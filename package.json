{
  "name": "pi-coact",
  "version": "1.3.0",
  "description": "CoACT — action-preserving observation compression for Pi coding agents (forked from pi-context-prune).",
  "type": "module",
  "scripts": {
    "build": "echo 'nothing to build'",
    "check": "for f in index.ts src/*.ts; do node --experimental-strip-types --check \"$f\" || exit 1; done",
    "test": "node --experimental-strip-types --test test/*.test.ts"
  },
  "keywords": [
    "pi-package",
    "context",
    "compression",
    "coact"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pinion05/PI-CoACT.git"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/pinion05/PI-CoACT/issues"
  },
  "homepage": "https://github.com/pinion05/PI-CoACT#readme",
  "files": [
    "index.ts",
    "src/",
    "test/",
    "*.md"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-tui": "*",
    "@sinclair/typebox": "*"
  }
}
