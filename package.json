{
  "name": "pi-context-prune",
  "version": "3.2.0",
  "description": "Pi extension package for pruning future context while preserving original tool-call history.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/index.js",
    "dist/index.d.ts",
    "dist/src/*.js",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "npm run build && npm run check:package && npm test",
    "test": "npm run build && node --test scripts/test-usage.mjs scripts/test-status.mjs",
    "check:package": "node scripts/check-package.mjs",
    "prepack": "npm run build && npm run check:package",
    "prepublishOnly": "npm run check"
  },
  "keywords": [
    "pi-package"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/championswimmer/pi-context-prune.git"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/championswimmer/pi-context-prune/issues"
  },
  "homepage": "https://github.com/championswimmer/pi-context-prune#readme",
  "pi": {
    "extensions": [
      "./dist/index.js"
    ],
    "image": "https://raw.githubusercontent.com/championswimmer/pi-context-prune/main/assets/banner.png"
  },
  "dependencies": {
    "pi-extension-settings-tui": "^0.4.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": ">=1.5.0",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^1.5.2",
    "@earendil-works/pi-coding-agent": "^1.5.2",
    "@earendil-works/pi-tui": "^1.5.2",
    "@types/node": "^22.0.0",
    "typebox": "^1.3.27",
    "typescript": "^5.9.0"
  }
}
